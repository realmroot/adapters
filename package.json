{
  "name": "realmroot-adapters",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --strict-vars=false --env-file .dev.vars.example",
    "types:check": "wrangler types --strict-vars=false --env-file .dev.vars.example --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage --project unit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:check": "ruby scripts/check-docs.rb"
  },
  "dependencies": {
    "hono": "^4.12.18",
    "jose": "6.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260808.1",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.2",
    "wrangler": "4.120.0"
  }
}
