{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "realmroot-adapters",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "routes": [{ "pattern": "adapters.realmroot.dev", "custom_domain": true }],
  "vars": {
    "REALMROOT_ISSUER": "https://id.realmroot.dev/api/auth",
    "REALMROOT_JWKS_URL": "https://id.realmroot.dev/api/auth/jwks",
    "REALMROOT_AGENT_PROFILE_URI_TEMPLATE": "https://id.realmroot.dev/api/public/agents/{subject}",
    "GITHUB_API_ORIGIN": "https://api.github.com",
    "GITHUB_UPLOADS_ORIGIN": "https://uploads.github.com",
    "LINEAR_API_ORIGIN": "https://api.linear.app",
    "LINEAR_AUTHORIZATION_ORIGIN": "https://linear.app",
    "CLOUDFLARE_API_ORIGIN": "https://api.cloudflare.com/client/v4",
    "CLOUDFLARE_AUTHORIZATION_ORIGIN": "https://dash.cloudflare.com"
  },
  "assets": { "directory": "./public" },
  "secrets": {
    "required": [
      "GITHUB_APP_ID",
      "GITHUB_PRIVATE_KEY",
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET",
      "GITHUB_CREDENTIAL_ENCRYPTION_KEY",
      "GITHUB_WEBHOOK_SECRET",
      "LINEAR_CLIENT_ID",
      "LINEAR_CLIENT_SECRET",
      "LINEAR_CREDENTIAL_ENCRYPTION_KEY",
      "LINEAR_WEBHOOK_SECRET",
      "ADAPTER_OAUTH_SIGNING_PRIVATE_JWK",
      "CLOUDFLARE_CLIENT_ID",
      "CLOUDFLARE_CLIENT_SECRET",
      "CLOUDFLARE_CREDENTIAL_ENCRYPTION_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "realmroot-adapters",
      "database_id": "6727387a-6897-4f2a-986f-e974a2008866",
      "migrations_dir": "./migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
