{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!!dist",
      "!!coverage",
      "!!.wrangler",
      "!!worker-configuration.d.ts",
      "!!public/cloudflare/openapi.json",
      "!!providers/cloudflare/exclusions.json",
      "!!providers/cloudflare/oauth-scopes.json",
      "!!src/providers/cloudflare/operation-permissions.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded"
    }
  }
}
